{
  "name": "bezpecnostni-prehled",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sber": "tsx sber/index.ts",
    "sber:provoz": "tsx sber/index.ts --jen-provoz",
    "test": "vitest run testy",
    "kontrola": "npm run kontrola:data && npm test && npm run typecheck && npm run build && npm run nahled && npm ci --prefix api && npm run test:api && npm run typecheck:api",
    "kontrola:data": "node nastroje/kontrola-dat.mjs",
    "naklady": "node nastroje/naklady.mjs",
    "test:api": "npm --prefix api test",
    "typecheck:api": "npm --prefix api run typecheck",
    "sber:zdroje": "tsx sber/test-zdroju.ts",
    "nahled": "next build && node nastroje/nahled-artefakt.mjs",
    "nahled:ukazka": "NEXT_PUBLIC_REZIM=ukazka next build && NEXT_PUBLIC_REZIM=ukazka node nastroje/nahled-artefakt.mjs",
    "preloz": "tsx nastroje/preloz.ts",
    "preklady:vytez": "node nastroje/vytez-preklady.mjs --zapis",
    "sber:kanaly": "tsx sber/test-kanalu.ts",
    "spravce": "node nastroje/spravce.mjs",
    "audit": "tsx nastroje/audit.ts",
    "fronta:srovnej": "node nastroje/srovnej-frontu.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "next": "^16.3.5",
    "openai": "^7.15.0",
    "posthog-js": "^1.434.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
