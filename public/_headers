# Hlavičky pro Cloudflare Pages.
#
# Proč to tu je: stránka se po nasazení lidem neměnila. Build i nasazení
# byly správně, ale prohlížeč dál servíroval starou kopii HTML — a ta
# odkazovala na staré soubory buildu, takže se nezměnilo vůbec nic.
#
# Pravidlo je jednoduché: co má v názvu otisk obsahu, smí se cachovat
# navždy; co ho nemá, se musí pokaždé ověřit u serveru.

/*
  Cache-Control: public, max-age=0, must-revalidate
  # Bezpečnost (30. 9. 2026, audit po zveřejnění webu):
  # - web nejde vložit do cizího rámu (podvržené kliknutí ve správě a účtu),
  # - jen HTTPS, i pro poddomény (api.),
  # - prohlížeč nesmí web pustit ke kameře, mikrofonu ani platbám; poloha
  #   jen pro tento web (připravovaná „Použít moji polohu“),
  # - CSP zatím jen rámy, pluginy a základní adresa; skripty a spojení se
  #   omezí, až bude ověřené, že tím nevypadne měření ani analytika.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Soubory buildu mají v názvu hash. Když se obsah změní, změní se i název,
# takže je bezpečné držet je v mezipaměti dlouho.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker se nesmí cachovat nikdy. Kdyby se cachoval, zůstala by
# v prohlížeči stará pravidla pro ukládání a web by se neaktualizoval
# ani po nasazení.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Rychlý přehled si snímek stahuje za běhu. Nesmí ho podržet ani prohlížeč,
# ani hrana CDN: stará kopie by po výpadku sběru dál vypadala jako nová
# (prohlížeč sice stáří dopočítá z časů uvnitř, ale novější stav by neviděl).
/prehled.json
  Cache-Control: no-store
